# Environment Configuration
# Copy this file to .env and update with your environment values

# Application URLs
BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:5000/api/v1

# Test User Credentials
ADMIN_USERNAME=admin@test.lk
ADMIN_PASSWORD=Test@1234

PAYROLL_MGR_USERNAME=payroll.mgr@test.lk
PAYROLL_MGR_PASSWORD=Test@1234

HR_MGR_USERNAME=hr.mgr@test.lk
HR_MGR_PASSWORD=Test@1234

ACCOUNTANT_USERNAME=accountant@test.lk
ACCOUNTANT_PASSWORD=Test@1234

EMPLOYEE_USERNAME=employee@test.lk
EMPLOYEE_PASSWORD=Test@1234

# Database Configuration (for DB validation)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=PayrollDB
DB_USER=sa
DB_PASSWORD=YourPassword

# Test Execution Settings
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000
RETRY_COUNT=2
WORKERS=4

# Reporting
ALLURE_RESULTS_DIR=allure-results
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# Test Data
TEST_DATA_PATH=./fixtures/test_data_employees.json
CLEANUP_AFTER_TEST=true

# Feature Flags (if applicable)
ENABLE_AUDIT_TRAIL=true
ENABLE_EMAIL_NOTIFICATIONS=false
